# Base de données — PostgreSQL (Neon recommandé)
# Obtenir sur https://neon.tech → Create Project → Copy connection string
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# Auth.js — générer avec `npx auth secret` (ou openssl rand -base64 32)
AUTH_SECRET="remplace-par-une-chaine-32-caracteres-aleatoire"
# URL publique du site (dev = http://localhost:3000, prod = https://shamydrive.ma)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI — https://platform.openai.com/api-keys → Create new secret key
OPENAI_API_KEY="sk-proj-xxx"

# Cloudinary — https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME="ton-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="ton-api-secret"

# Resend — https://resend.com → API Keys → Create
# Pour emails de confirmation réservation (de: noreply@shamydrive.ma doit être domaine vérifié)
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Shamy Drive <noreply@shamydrive.ma>"
# Email admin qui reçoit l'alerte à chaque nouvelle réservation PENDING (à toi)
# Mets l'adresse où tu veux être notifié — ex: ADMIN_EMAIL="contact@shamydrive.ma"
ADMIN_EMAIL="contact@shamydrive.ma"
# WhatsApp admin pour alerte (optionnel, même numéro que client ou perso)
ADMIN_WHATSAPP="212661689659"

# Optionnel — si tu utilises SMTP Nodemailer au lieu de Resend (choisis l'un ou l'autre)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="ton-email@gmail.com"
# SMTP_PASSWORD="ton-mot-de-passe-app"
